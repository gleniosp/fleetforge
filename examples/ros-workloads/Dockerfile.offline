FROM ghcr.io/prefix-dev/pixi:0.83.0@sha256:3dce86c6e87371c58035aa41b09f2b56ca8f011722320551e0c2bfc1c59da5fb AS pixi

FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

# The container supplies system trust; Python and ROS come from the release locks.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pixi /usr/local/bin/pixi /usr/local/bin/pixi

ENV PIXI_NO_CONFIG=true

# Only these explicit source files enter the offline experiment image.
COPY LICENSE pixi.toml pixi.lock /source/
COPY tools/__init__.py /source/tools/
COPY tools/releases/__init__.py tools/releases/catalog.py tools/releases/trust.py /source/tools/releases/
COPY schemas/releases/v1/catalog.schema.json schemas/releases/v1/common.schema.json schemas/releases/v1/keyring.schema.json schemas/releases/v1/release.schema.json schemas/releases/v1/signature.schema.json /source/schemas/releases/v1/
COPY examples/releases/ros-counter-a-v1/pixi.toml examples/releases/ros-counter-a-v1/pixi.lock examples/releases/ros-counter-a-v1/release.json /source/examples/releases/ros-counter-a-v1/
COPY examples/releases/ros-counter-a-v1/app/main.py examples/releases/ros-counter-a-v1/app/common.py examples/releases/ros-counter-a-v1/app/health.py /source/examples/releases/ros-counter-a-v1/app/
COPY examples/releases/ros-counter-b-v1/pixi.toml examples/releases/ros-counter-b-v1/pixi.lock examples/releases/ros-counter-b-v1/release.json /source/examples/releases/ros-counter-b-v1/
COPY examples/releases/ros-counter-b-v1/app/main.py examples/releases/ros-counter-b-v1/app/common.py examples/releases/ros-counter-b-v1/app/health.py /source/examples/releases/ros-counter-b-v1/app/
COPY examples/ros-workloads/check_workloads.py examples/ros-workloads/lifecycle.py /source/examples/ros-workloads/
