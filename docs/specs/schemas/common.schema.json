{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "not": {
        "pattern": "\n"
      }
    },
    "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$",
      "not": {
        "pattern": "\n"
      }
    },
    "hex_32_bytes": {
      "description": "32 raw bytes encoded as exactly 64 lowercase hexadecimal characters.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "sha256": {
      "$ref": "#/$defs/hex_32_bytes"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "prefixItems": [
            {
              "$ref": "common.schema.json#/$defs/path"
            }
          ],
          "items": {
            "type": "string",
            "maxLength": 1024,
            "not": {
              "pattern": "\u0000"
            }
          }
        },
        "cwd": {
          "anyOf": [
            {
              "const": "."
            },
            {
              "$ref": "common.schema.json#/$defs/path"
            }
          ]
        }
      }
    }
  }
}
