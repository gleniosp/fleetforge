{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publishers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "publishers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "algorithm",
          "public_key"
        ],
        "properties": {
          "key_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "public_key": {
            "$ref": "common.schema.json#/$defs/hex_32_bytes"
          }
        }
      }
    }
  }
}
